#!/usr/bin/env bash
# BulkPublish for Omarchy: the part that talks to BulkPublish.
#
# The panel never builds a request itself. It runs this script with an argv
# array (never through a shell) and reads one JSON object back on stdout:
# {"ok":true,...} or {"ok":false,"error":"..."}. Keeping every request here
# means the API key is only ever read by this file, never handed to QML.
#
#   bulkpublish login            read an API key from the terminal and save it
#   bulkpublish logout           forget the saved key
#   bulkpublish status           is a key saved, and does BulkPublish accept it
#   bulkpublish channels         connected channels
#   bulkpublish posts [limit]    recent posts, newest first
#   bulkpublish send <now|draft|queue|at> <channel-ids,comma,separated> [when]
#                                stdin: {"text":"...","files":["/path",...]}
#                                "at" takes a time like "fri 14:30"
#   bulkpublish pick             choose media files in the desktop's file picker
#   bulkpublish when <time>      how a typed time is understood, without posting
#   bulkpublish retry <post-id>
#   bulkpublish open [path]      open BulkPublish in the browser
set -uo pipefail

API_BASE="${BULKPUBLISH_API_BASE:-https://app.bulkpublish.com}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/bulkpublish"
KEY_FILE="$CONFIG_DIR/omarchy-api-key"

# Media uploaded for a post that then fails to be created is deleted again, so
# a refused post leaves nothing behind in the library.
UPLOADED=()
fail() { forget_uploads; jq -cn --arg e "$1" '{ok:false,error:$e}'; exit 0; }

# GNU date reads "tomorrow 9:00" and friends. Omarchy ships it as date; gdate is
# for running this script on a Mac.
DATE=date
if ! date -d @0 >/dev/null 2>&1 && command -v gdate >/dev/null 2>&1; then DATE=gdate; fi

# The machine's IANA timezone, so BulkPublish shows and counts scheduled posts
# in the same day the user sees. Anything that does not look like a zone name
# falls back to UTC rather than being sent.
local_tz() {
  local tz="${TZ:-}"
  [ -n "$tz" ] || tz="$(timedatectl show -p Timezone --value 2>/dev/null)"
  [ -n "$tz" ] || tz="$(readlink /etc/localtime 2>/dev/null | sed -n 's|.*/zoneinfo/||p')"
  tz="${tz#:}"
  [[ "$tz" =~ ^[A-Za-z]+(/[A-Za-z0-9_+-]+)*$ ]] || tz=UTC
  printf '%s' "$tz"
}

# when_at TEXT -> sets AT (ISO, UTC) and LABEL, or fails with a message the
# panel can show as is.
when_at() {
  local text="$1" epoch now
  [ -n "${text//[[:space:]]/}" ] || fail "Type when to post it, like tomorrow 9:00."
  epoch="$($DATE -d "$text" +%s 2>/dev/null)" || fail "Couldn't read that time. Try tomorrow 9:00 or 2026-11-03 18:00."
  [[ "$epoch" =~ ^[0-9]+$ ]] || fail "Couldn't read that time. Try tomorrow 9:00 or 2026-11-03 18:00."
  now="$($DATE +%s)"
  [ "$epoch" -gt $((now + 60)) ] || fail "That time has already passed."
  AT="$($DATE -u -d "@$epoch" +%Y-%m-%dT%H:%M:%SZ)"
  LABEL="$($DATE -d "@$epoch" '+%a %-d %b, %H:%M')"
}

need() {
  command -v curl >/dev/null 2>&1 || { echo '{"ok":false,"error":"curl is not installed."}'; exit 0; }
  command -v jq >/dev/null 2>&1 || { echo '{"ok":false,"error":"jq is not installed."}'; exit 0; }
}

read_key() {
  [ -r "$KEY_FILE" ] || fail "No API key yet. Run the login command shown in the panel."
  KEY="$(tr -d '[:space:]' <"$KEY_FILE")"
  [ -n "$KEY" ] || fail "No API key yet. Run the login command shown in the panel."
}

# settle OUTPUT -> sets BODY and CODE from "body\nstatus", or fails with a
# message the panel can show as is.
settle() {
  local out="$1"
  CODE="$(tail -n 1 <<<"$out")"
  BODY="$(sed '$d' <<<"$out")"
  [[ "$CODE" =~ ^[0-9]{3}$ ]] || fail "Couldn't reach BulkPublish. Check your connection and try again."
  if [ "$CODE" -ge 200 ] && [ "$CODE" -lt 300 ]; then return 0; fi
  local msg
  msg="$(jq -r 'if (.error|type)=="string" then .error
               elif (.error|type)=="object" then ((.error.message // "") + (if .error.hint then " " + .error.hint else "" end))
               else (.message // "") end' <<<"$BODY" 2>/dev/null)"
  case "$CODE" in
    401) fail "BulkPublish didn't accept the API key. Run the login command shown in the panel again." ;;
    403) [ -n "$msg" ] || msg="This API key is not allowed to do that."; fail "$msg" ;;
    402|429) [ -n "$msg" ] || msg="You have reached your BulkPublish plan limit."; fail "$msg" ;;
    5*) fail "BulkPublish is having trouble right now. Try again in a few minutes." ;;
    *) fail "${msg:-BulkPublish returned an error ($CODE).}" ;;
  esac
}

# api METHOD PATH [JSON-BODY]  -> sets BODY and CODE
api() {
  local method="$1" path="$2" data="${3:-}" out
  local args=(-sS --max-time 30 -X "$method" -w '\n%{http_code}'
    -H "Accept: application/json" -H "User-Agent: bulkpublish-omarchy/1.2.0")
  # Neither the key nor the body is ever an argv value, because any local
  # account can read a running process's command line. The key goes in as a
  # header file on fd 3 and the body on stdin.
  args+=(-H @/dev/fd/3)
  if [ -n "$data" ]; then args+=(-H "Content-Type: application/json" --data-binary @-); fi
  out="$(printf '%s' "$data" |
    curl "${args[@]}" "$API_BASE$path" 3< <(printf 'Authorization: Bearer %s\n' "$KEY") 2>/dev/null)" ||
    fail "Couldn't reach BulkPublish. Check your connection and try again."
  settle "$out"
}

MB=$((1024 * 1024))
PART=$((10 * MB))

# media_type NAME -> the MIME type BulkPublish accepts for it, or nothing.
media_type() {
  case "$(printf '%s' "${1##*.}" | tr '[:upper:]' '[:lower:]')" in
    jpg|jpeg) echo image/jpeg ;; png) echo image/png ;; webp) echo image/webp ;;
    gif) echo image/gif ;; mp4|m4v) echo video/mp4 ;; mov) echo video/quicktime ;;
    webm) echo video/webm ;; pdf) echo application/pdf ;;
    doc) echo application/msword ;;
    docx) echo application/vnd.openxmlformats-officedocument.wordprocessingml.document ;;
    ppt) echo application/vnd.ms-powerpoint ;;
    pptx) echo application/vnd.openxmlformats-officedocument.presentationml.presentation ;;
  esac
}

# check_file PATH -> sets MIME and SIZE, or fails saying what is wrong with it.
check_file() {
  local path="$1" name="${1##*/}"
  [ -f "$path" ] && [ -r "$path" ] || fail "Can't read $name. It may have been moved or deleted."
  MIME="$(media_type "$name")"
  [ -n "$MIME" ] || fail "$name isn't a file type BulkPublish can post. Use an image (JPEG, PNG, WebP, GIF), a video (MP4, MOV, WebM), or a PDF, Word or PowerPoint file."
  SIZE="$(wc -c <"$path" | tr -d '[:space:]')"
  [ "$SIZE" -gt 0 ] || fail "$name is empty."
  case "$MIME" in
    video/*) [ "$SIZE" -le $((1024 * MB)) ] || fail "$name is larger than 1 GB, the limit for videos." ;;
    *) [ "$SIZE" -le $((100 * MB)) ] || fail "$name is larger than 100 MB, the limit for images and documents." ;;
  esac
}

# upload PATH -> appends the new media file's id to UPLOADED.
#
# The bytes go in on stdin, and everything that names the file (its name, the
# key, a large upload's signed storage links) goes in through a curl config on
# fd 3, so none of it shows up in the process list.
upload() {
  local path="$1" name safe mime size out id
  name="${path##*/}"
  check_file "$path"
  mime="$MIME" size="$SIZE"
  # The name sits inside a quoted curl config value, where only a quote, a
  # backslash or a control character would need escaping. Swap those out.
  safe="${name//[\"\\[:cntrl:]]/_}"
  if [ "$size" -le $((100 * MB)) ]; then
    out="$(curl -sS --max-time 900 -w '\n%{http_code}' -H "Accept: application/json" \
      -H "User-Agent: bulkpublish-omarchy/1.2.0" -K /dev/fd/3 "$API_BASE/api/media" <"$path" \
      3< <(printf 'header = "Authorization: Bearer %s"\nform = "file=@-;filename=\\"%s\\";type=%s"\n' \
             "$KEY" "$safe" "$mime") 2>/dev/null)" ||
      fail "Couldn't upload $name. Check your connection and try again."
    settle "$out"
  else
    upload_large "$path" "$name" "$mime" "$size"
  fi
  id="$(jq -r '.file.id // empty' <<<"$BODY")"
  [[ "$id" =~ ^[0-9]+$ ]] || fail "BulkPublish didn't confirm the upload of $name."
  UPLOADED+=("$id")
}

# Videos over 100 MB go up in 10 MB parts straight to storage. A part that
# fails is retried on its own rather than restarting the whole file.
upload_large() {
  local path="$1" name="$2" mime="$3" size="$4" key upload_id count i url res etag parts="[]" urls
  api POST /api/media/multipart/create "$(jq -cn --arg m "$mime" --argjson s "$size" '{contentType:$m,sizeBytes:$s}')"
  urls="$BODY"
  key="$(jq -r '.r2Key // empty' <<<"$urls")"
  upload_id="$(jq -r '.uploadId // empty' <<<"$urls")"
  count="$(jq -r '(.partUrls // []) | length' <<<"$urls")"
  [ -n "$key" ] && [ -n "$upload_id" ] && [ "$count" -gt 0 ] || fail "BulkPublish couldn't start the upload of $name."
  for ((i = 0; i < count; i++)); do
    url="$(jq -r ".partUrls[$i]" <<<"$urls")"
    [[ "$url" =~ ^https?://[^\"\\[:space:]]+$ ]] || fail "BulkPublish couldn't start the upload of $name."
    etag=""
    for _ in 1 2 3; do
      # The file comes in by redirection, so its path is never an argument.
      res="$(dd bs="$PART" skip="$i" count=1 iflag=fullblock <"$path" 2>/dev/null |
        curl -sS --max-time 300 -X PUT --data-binary @- -o /dev/null -w '%{http_code} %header{etag}' \
          -K /dev/fd/3 3< <(printf 'url = "%s"\n' "$url") 2>/dev/null)"
      if [ "${res%% *}" = 200 ] && [ -n "${res#* }" ]; then etag="${res#* }"; break; fi
    done
    if [ -z "$etag" ]; then
      ( api POST /api/media/multipart/abort "$(jq -cn --arg k "$key" --arg u "$upload_id" '{r2Key:$k,uploadId:$u}')" ) >/dev/null 2>&1
      fail "Couldn't upload $name. Check your connection and try again."
    fi
    parts="$(jq -c --argjson n $((i + 1)) --arg e "$etag" '. + [{partNumber:$n,etag:$e}]' <<<"$parts")"
  done
  api POST /api/media/multipart/complete "$(jq -cn --arg k "$key" --arg u "$upload_id" --argjson p "$parts" \
    --arg f "$name" --arg m "$mime" --argjson s "$size" \
    '{r2Key:$k,uploadId:$u,parts:$p,fileName:$f,mimeType:$m,sizeBytes:$s}')"
}

# Delete what this run uploaded. Best effort and silent: it runs on the way out
# of a failure, which has its own message to show.
forget_uploads() {
  local id
  for id in "${UPLOADED[@]+"${UPLOADED[@]}"}"; do
    curl -sS --max-time 20 -X DELETE -o /dev/null -K /dev/fd/3 "$API_BASE/api/media/$id" \
      3< <(printf 'header = "Authorization: Bearer %s"\n' "${KEY:-}") >/dev/null 2>&1
  done
  UPLOADED=()
}

cmd="${1:-}"; shift || true
case "$cmd" in
  login)
    command -v curl >/dev/null 2>&1 || { echo "curl is not installed." >&2; exit 1; }
    command -v jq >/dev/null 2>&1 || { echo "jq is not installed." >&2; exit 1; }
    echo "Create a key in BulkPublish on its API page, then paste it here."
    printf "API key: "
    IFS= read -rs KEY; echo
    KEY="$(printf '%s' "$KEY" | tr -d '[:space:]')"
    [ -n "$KEY" ] || { echo "Nothing entered, nothing saved." >&2; exit 1; }
    out="$(api GET /api/channels)"
    if [ -n "$out" ]; then echo "$(jq -r .error <<<"$out")" >&2; exit 1; fi
    mkdir -p "$CONFIG_DIR" && chmod 700 "$CONFIG_DIR"
    (umask 077 && printf '%s\n' "$KEY" >"$KEY_FILE")
    echo "Saved. The BulkPublish widget picks it up the next time it refreshes."
    command -v omarchy-shell >/dev/null 2>&1 && omarchy-shell com.bulkpublish.omarchy refresh >/dev/null 2>&1
    exit 0
    ;;
  logout)
    rm -f "$KEY_FILE"
    echo "Forgot the saved API key."
    exit 0
    ;;
esac

need
case "$cmd" in
  when)
    when_at "${1:-}"
    jq -cn --arg at "$AT" --arg label "$LABEL" '{ok:true,at:$at,label:$label}'
    ;;
  pick)
    # The desktop's own file picker, through the portal every Omarchy install
    # runs. A small helper holds the request open until the user answers.
    command -v python3 >/dev/null 2>&1 || fail "Choosing files needs python3. You can drag files onto the panel instead."
    out="$(python3 -I "$(dirname "$0")/pick-media" 2>/dev/null)" ||
      fail "The file picker didn't open. You can drag files onto the panel instead."
    printf '%s\n' "$out"
    ;;
  status)
    [ -r "$KEY_FILE" ] || { echo '{"ok":true,"signedIn":false}'; exit 0; }
    read_key
    api GET /api/channels
    echo '{"ok":true,"signedIn":true}'
    ;;
  channels)
    read_key
    api GET /api/channels
    jq -c '{ok:true, channels: [(.channels // [])[] | {
        id, platform,
        name: (.accountName // .name // ("#" + (.id|tostring))),
        problem: (if .isActive == false then "turned off"
                  elif .needsReconnect == true or .tokenStatus == "expired" then "needs reconnecting"
                  elif .platformAvailable == false then "unavailable"
                  else "" end)
      }]}' <<<"$BODY"
    ;;
  posts)
    read_key
    limit="${1:-10}"
    [[ "$limit" =~ ^[0-9]+$ ]] || limit=10
    api GET "/api/posts?limit=$limit&order=desc"
    jq -c '{ok:true, posts: [(.posts // [])[] | {
        id, status: (.status // "unknown"),
        content: ((.content // "") | gsub("\\s+"; " ") | .[0:140]),
        at: (.publishedAt // .scheduledAt // .createdAt // null),
        platforms: [(.postPlatforms // [])[] | .platform] | unique,
        error: ([(.postPlatforms // [])[] | .errorMessage // empty] | first // "")
      }]}' <<<"$BODY"
    ;;
  send)
    mode="${1:-}" ids="${2:-}"
    # Text and file paths arrive on stdin so they never appear in the process list.
    input="$(cat)"
    text="$(jq -r '.text // ""' <<<"$input" 2>/dev/null)" || fail "Write something first."
    files=()
    while IFS= read -r -d '' f; do files+=("$f"); done \
      < <(jq -j '(.files // [])[] | tostring + "\u0000"' <<<"$input" 2>/dev/null)
    case "$mode" in now|draft|queue|at) ;; *) fail "Choose when to post it." ;; esac
    [[ "$ids" =~ ^[0-9]+(,[0-9]+)*$ ]] || fail "Pick at least one channel."
    [ -n "${text//[[:space:]]/}" ] || [ "${#files[@]}" -gt 0 ] || fail "Write something or add media first."
    # Check every file before any is uploaded, so one bad file costs nothing.
    for f in "${files[@]+"${files[@]}"}"; do check_file "$f"; done
    # Check a typed time before anything is sent, so a typo costs nothing.
    AT="" LABEL=""
    [ "$mode" = at ] && when_at "${3:-}"
    read_key
    tz="$(local_tz)"
    if [ "$mode" = queue ]; then
      api GET "/api/posts/queue-slot?timezone=$tz"
      AT="$(jq -r '.scheduledAt // empty' <<<"$BODY")"
      epoch="$($DATE -d "$AT" +%s 2>/dev/null)" || fail "BulkPublish didn't return a queue slot."
      LABEL="$($DATE -d "@$epoch" '+%a %-d %b, %H:%M')"
    fi
    # The body needs each channel's platform, so look them up rather than
    # trusting whatever the panel last saw.
    api GET /api/channels
    channels="$(jq -c --arg ids "$ids" '
      ($ids | split(",") | map(tonumber)) as $want
      | [(.channels // [])[] | select(.id as $i | $want | index($i)) | {channelId: .id, platform}]
      | if length == 0 then error("none") else . end' <<<"$BODY" 2>/dev/null)" ||
      fail "Those channels are no longer connected. Refresh and pick again."
    for f in "${files[@]+"${files[@]}"}"; do upload "$f"; done
    media="$(printf '%s\n' "${UPLOADED[@]+"${UPLOADED[@]}"}" | jq -cRs 'split("\n") | map(select(. != "") | tonumber)')"
    body="$(jq -cn --rawfile text <(printf '%s' "$text") --argjson ch "$channels" --argjson media "$media" \
      --arg at "$AT" --arg tz "$tz" '
      {content: $text, channels: $ch}
      + (if ($media | length) > 0 then {mediaFiles: $media} else {} end)
      + (if $at == "" then {status: "draft"} else {status: "scheduled", scheduledAt: $at, timezone: $tz} end)')"
    api POST /api/posts "$body"
    id="$(jq -r '.id // empty' <<<"$BODY")"
    [[ "$id" =~ ^[0-9]+$ ]] || fail "BulkPublish didn't return the new post."
    if [ "$mode" = now ]; then
      # Both calls run in subshells that leave the uploads to the clean-up
      # below, so the post goes first and its media once, after it.
      if ! out="$(UPLOADED=(); api POST "/api/posts/$id/publish")" || [ -n "$out" ]; then
        # Publishing refused: take the draft back out so nothing half-made is left.
        # In a subshell, because a failed delete would otherwise end the script
        # here and the user would never see why publishing was refused.
        ( UPLOADED=(); api DELETE "/api/posts/$id" ) >/dev/null 2>&1
        forget_uploads
        echo "$out"; exit 0
      fi
    fi
    # The post owns its media now.
    UPLOADED=()
    jq -cn --argjson id "$id" --arg mode "$mode" --arg label "$LABEL" '{ok:true,id:$id,mode:$mode,label:$label}'
    ;;
  retry)
    [[ "${1:-}" =~ ^[0-9]+$ ]] || fail "No post to retry."
    read_key
    api POST "/api/posts/$1/retry" '{}'
    echo '{"ok":true}'
    ;;
  open)
    path="${1:-/}"
    [[ "$path" =~ ^/[A-Za-z0-9/_?=\&.-]*$ ]] || path=/
    xdg-open "$API_BASE$path" >/dev/null 2>&1 &
    echo '{"ok":true}'
    ;;
  *)
    sed -n '9,20p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
    ;;
esac
